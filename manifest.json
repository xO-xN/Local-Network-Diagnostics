{
  "schemaVersion": 2,
  "id": "local-network-diagnostics",
  "name": "Local Network Diagnostics",
  "version": "0.7.1",
  "description": "PNDS score project for local network diagnostics: measures Wi-Fi round-trip time, jitter and loss between the server and its clients in real time.",
  "scoreServer": {
    "entry": "server.js",
    "workingDirectory": ".",
    "performerPort": 6868,
    "monitorPort": 6869
  },
  "audio": {
    "defaultMode": "none",
    "supportedModes": [
      "none"
    ]
  },
  "sharedLibraries": [
    {
      "id": "express",
      "version": "5.3.0"
    },
    {
      "id": "socket.io",
      "version": "4.8.4"
    }
  ]
}
